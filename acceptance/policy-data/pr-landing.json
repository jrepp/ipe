        "schema": {
          "type": "string"
        }
      }
    }
  },
  "collections": {
    "pull_requests": {
      "schema": {
        "type": "record",
        "fields": {
          "approvers": {
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "max_items": 20
            }
          },
          "passed_checks": {
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "max_items": 20
            }
          }
        }
      },
      "max_ttl_seconds": 600,
      "max_observation_age_seconds": 600,
      "source_id": "forge-runtime",
      "mode": "push"
    }
  },
  "documents": [
    {
      "id": "pr-landing",
      "title": "Pull request landing requirements",
      "data": {
        "schema": {
          "type": "record",
          "fields": {
            "review": {
              "schema": {
                "type": "record",
                "fields": {
                  "minimum": {
                    "schema": {
                      "type": "int"
                    }
                  }
                }
              }
            },
            "required_checks": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "max_items": 20
              }
            }
          }
        },
        "value": {
          "review": {
            "minimum": 2
          },
          "required_checks": [
            "test",
            "lint"
          ]
        }
      },
      "external": {
        "system": "example-forge",
        "locator": "https://forge.example/repos/acme/app/rules/main",
        "source_revision": "rules-7",
        "source_digest": "c7719b265189208486fd4eff751fc82a7bec41fc228d1aabdb211213b8972b65",
        "observed_at": 100,
        "valid_until": 400
      },
      "sections": [
        {
          "id": "reviews",
          "title": "Distinct approving reviewers",
          "source_pointer": "/review/minimum",
          "rule": {
            "kind": "modeled",
            "source": "language 2\npolicy Landing: \"Required pull request checks\"\ntriggers when input.operation == \"merge\"\nfacts\n  pr = data.pull_requests[input.commit] fresh within 5m\nrequires count_distinct(a for a in pr.value.approvers) >= policy.review.minimum"
          }
        },
        {
          "id": "checks",
          "title": "Required checks on this commit",
          "source_pointer": "/required_checks",
          "rule": {
            "kind": "modeled",
            "source": "language 2\npolicy Landing: \"Required pull request checks\"\ntriggers when input.operation == \"merge\"\nfacts\n  pr = data.pull_requests[input.commit] fresh within 5m\nrequires all(check in pr.value.passed_checks for check in policy.required_checks)"
          }
        }
      ]
    },
